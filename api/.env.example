# ─────────────────────────────────────────────────────────────
# Sendy Errands API — copy to `.env` and fill in. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed origins for the mobile/web clients.
# Expo web (8081/19006) plus the admin dashboard (Vite dev 5180, preview 4180).
# 5173 is avoided because it is Vite's default and clashes with other projects.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:5180,http://localhost:4180

# ── Database ────────────────────────────────────────────────
# DATABASE_URL = pooled connection, used by the running API.
# DIRECT_URL   = unpooled connection, used only by `prisma migrate`.
# On a plain local Postgres, set both to the same string.
#
# Supabase → Project Settings → Database → Connection string:
#   DATABASE_URL = Transaction pooler (6543), add ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = Session pooler (5432)
# Prefer the poolers over "Direct connection" — the latter is IPv6-only unless
# you have Supabase's IPv4 add-on.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sendy?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/sendy?schema=public

# ── Auth ────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=30d

# ── Auth ───────────────────────────────────────────────────
# Sign-in is email + password. One-time codes are used only to prove control of
# an inbox when resetting a forgotten password.
#
# When true, the reset code is fixed and returned in the API response instead of
# being emailed. Keep true until RESEND_API_KEY below is live; it lets the reset
# flow be exercised with no email provider.
#
# NOTE: the API refuses to start with this on while PAYSTACK_SECRET_KEY is a
# live key — anyone who knows an email address could take that account over.
OTP_DEV_MODE=true
# The code accepted while OTP_DEV_MODE=true.
OTP_DEV_CODE=123456

# Reset codes per 15 minutes. Unset means 5 in production, 100 in development —
# testing an auth flow means requesting repeatedly, and the production ceiling
# locks you out of your own build.
# OTP_RATE_LIMIT_MAX=100

# ── Transactional email — Resend (https://resend.com) ───────
# Carries password reset codes. Verify the sending domain first: an unverified
# domain is accepted by the API and then silently binned by inbox providers,
# which looks exactly like the code being broken.
#
# WHATSAPP_* and TERMII_* used to live here, carrying the login OTP. Sign-in no
# longer uses a phone channel, so both were removed rather than left configured
# and unused. They are in the git history if order notifications ever want one.
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
EMAIL_FROM=Sendy Errands <no-reply@sendyerrands.com>
# Must be a real inbox — the root MX points at Zoho, not Resend. Someone will
# reply to a reset email, and this is whether that reaches anyone.
EMAIL_REPLY_TO=sendyerrands@sendyerrands.com

# ── Payments — Paystack (https://paystack.com) ──────────────
# Dashboard → Settings → API Keys & Webhooks.
# Use the TEST keys (sk_test_… / pk_test_…) until you go live.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Point Paystack's webhook at:  POST {your-api-url}/api/v1/payments/webhook
# The signature is verified with PAYSTACK_SECRET_KEY — no separate secret needed.

# ── Media — Cloudinary (https://cloudinary.com) ─────────────
# Dashboard → Settings → API Keys. The app uploads directly to Cloudinary
# using a signature minted by POST /api/v1/uploads/signature.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=sendy

# ── Business rules ──────────────────────────────────────────
# All money is stored in KOBO (1 naira = 100 kobo) to avoid float errors.
DEFAULT_DELIVERY_FEE_KOBO=130000
SERVICE_FEE_KOBO=30000
# The platform's cut of each delivery, in basis points (1500 = 15%).
PLATFORM_COMMISSION_BPS=1500
# How long a posted marketplace request accepts bids, in minutes.
BID_WINDOW_MINUTES=30
# How long an accepted job stays locked to one rider, in seconds.
JOB_LOCK_SECONDS=120

# ── seeding ──────────────────────────────────────────────────
# The admin the seed creates. Leave the password blank and the seed generates
# a random one and prints it once — never commit a working credential.
SEED_ADMIN_EMAIL=admin@sendy.ng
SEED_ADMIN_PASSWORD=
