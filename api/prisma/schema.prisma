// Sendy Errands MVP data model.
//
// Money rule: every amount is an Int of KOBO (1 naira = 100 kobo). Never store
// naira as a float — 0.1 + 0.2 problems become real refund disputes.
//
// Order is the single spine for all four pillars (food, marketplace, errand,
// package). Type-specific fields hang off ErrandDetail / PackageDetail so the
// rider, tracking and admin code paths stay identical across pillars.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection — what the running API uses.
  url       = env("DATABASE_URL")
  // Direct (unpooled) connection — migrations only. PgBouncer can't run the
  // DDL and advisory locks `prisma migrate` needs, so it gets its own URL.
  // On a plain local Postgres, set both to the same string.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────── enums

/// Codes are no longer how anyone signs in — email and password are. What is
/// left is proving control of an inbox in order to set a new password, which is
/// scoped per account type because the same address may legitimately belong to
/// a customer and a rider at once.
enum OtpPurpose {
  CUSTOMER_PASSWORD_RESET
  RIDER_PASSWORD_RESET
  VENDOR_PASSWORD_RESET
  PROVIDER_PASSWORD_RESET
}

enum RiderStatus {
  PENDING // signed up, documents incomplete
  IN_REVIEW // documents submitted, awaiting admin
  APPROVED // may accept jobs
  REJECTED
  SUSPENDED
}

/// What a rider actually rides. Drives dispatch — a 3-bag grocery run cannot
/// go on a bicycle — and identifies them at the door.
enum VehicleType {
  MOTORBIKE
  BICYCLE
  TRICYCLE // keke napep
  CAR
  VAN
  FOOT
}

enum DocumentType {
  NIN
  LICENCE
  PHOTO
  VEHICLE_PAPERS
  GUARANTOR_FORM
}

enum DocumentStatus {
  MISSING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum OrderType {
  FOOD
  MARKETPLACE
  ERRAND
  PACKAGE
  /// Someone comes to you and does a job — a barber, a cleaner, a plumber.
  /// Shares the errand's negotiation machinery: the provider names a price
  /// once they know what the job is, and the customer accepts or walks away.
  SERVICE
}

/// How a service provider gets to the customer.
///
/// Not cosmetic — it is the one thing Sendy actually charges for on a service
/// booking, and the customer is choosing between cheap-and-exposed and
/// dearer-but-covered. A barber with clippers can ride; a cleaner with
/// equipment, or anyone travelling in the rain, cannot.
enum ArrivalMode {
  BIKE
  CAR
}

/// Where the order came in from. The app was the only channel until the
/// website's booking form started posting here too, and the two need telling
/// apart in the admin dashboard — a web booking has no logged-in customer
/// behind it, just a phone number someone typed.
enum OrderChannel {
  APP
  WEB
}

enum OrderStatus {
  /// Errands only. Posted with an estimate, unpaid, visible to every rider.
  /// The price is not knowable until someone stands in the market and looks,
  /// so nothing is charged until a rider has been and reported back.
  QUOTE_REQUESTED
  /// A rider has priced the item and named the merchant account. Waiting on
  /// the customer to accept the real price.
  PRICE_PROPOSED
  /// Customer says they have transferred the item cost to the merchant
  /// directly. Sendy never touches that money — only the dispatch fee.
  MERCHANT_PAID
  PENDING_PAYMENT
  PLACED
  VENDOR_ACCEPTED
  RIDER_ASSIGNED
  PICKED_UP
  IN_TRANSIT
  /// The rider is at the door. A distinct state because it is the moment the
  /// customer has to do something — come out, or answer the phone.
  AT_DOORSTEP
  DELIVERED
  CANCELLED
  REFUNDED
}

enum ParcelSize {
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
}

enum RequestStatus {
  OPEN // accepting bids
  BID_SELECTED
  EXPIRED
  CANCELLED
}

enum BidStatus {
  SUBMITTED
  SELECTED
  REJECTED
  WITHDRAWN
}

enum PaymentProvider {
  PAYSTACK
  WALLET
  CASH
  /// Money landed in the company account and someone in ops confirmed it. The
  /// website's customers pay this way or in cash, so without it every offline
  /// naira had to be filed as CASH and the two could not be told apart when
  /// reconciling against a bank statement.
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum WalletTxnType {
  TOPUP
  ORDER_DEBIT
  REFUND
  REFERRAL_BONUS
  PAYOUT
  ADJUSTMENT
}

enum AdminRole {
  SUPPORT
  OPERATIONS
  SUPERADMIN
}

// ─────────────────────────────────────────────── identity

model User {
  id                String   @id @default(cuid())
  /// The login identifier. Stored lowercased so "Ada@x.com" and "ada@x.com"
  /// cannot become two accounts holding two separate wallet balances.
  email             String   @unique
  passwordHash      String
  /// Still required, but no longer a credential: a rider standing at the door
  /// needs a number to call, which an email address cannot replace.
  phone             String   @unique // E.164, e.g. +2348031234567
  firstName         String
  lastName          String
  walletBalanceKobo Int      @default(0)
  referralCode      String   @unique
  referredByCode    String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  addresses          Address[]
  favourites         Favourite[]
  notifications      Notification[]
  orders             Order[]
  requests           MarketplaceRequest[]
  reviews            Review[]
  supportRequests    SupportRequest[]
  walletTxns         WalletTransaction[]
  vendorApplications VendorApplication[]
  providerApplications ProviderApplication[]

  @@map("users")
}

model Rider {
  id                    String       @id @default(cuid())
  /// Login identifier, lowercased. Unique within riders only — the same person
  /// may hold a customer account on the same address.
  email                 String       @unique
  passwordHash          String
  phone                 String       @unique
  firstName             String
  lastName              String
  /// Structured vehicle data, distinct from the VEHICLE_PAPERS document: this
  /// is what dispatch matches on, that is a scan a human checks once.
  vehicleType           VehicleType?
  plateNumber           String?
  zone                  String?
  status                RiderStatus  @default(PENDING)
  isOnline              Boolean      @default(false)
  rating                Float        @default(5)
  completedJobs         Int          @default(0)
  // Payout destination — verified against Paystack before any transfer.
  bankCode              String?
  bankAccountNo         String?
  bankName              String?
  /// The account holder's name as Paystack resolved it — never as the rider
  /// typed it. This is the only evidence that the account exists and belongs to
  /// someone, and it is what a human checks before releasing money.
  bankAccountName       String?
  /// Paystack's transfer recipient handle, created once and reused. Making a
  /// new recipient per payout is wasted calls and extra ways to get it wrong.
  paystackRecipientCode String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  documents     RiderDocument[]
  orders        Order[]
  earnings      RiderEarning[]
  payouts       Payout[]
  deliveryBids  DeliveryBid[]
  notifications Notification[]
  reviews       Review[]

  @@index([isOnline, status])
  @@map("riders")
}

model RiderDocument {
  id         String         @id @default(cuid())
  riderId    String
  type       DocumentType
  fileUrl    String
  status     DocumentStatus @default(IN_REVIEW)
  reviewNote String?
  reviewedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@unique([riderId, type])
  @@map("rider_documents")
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(OPERATIONS)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  paymentsRecorded Payment[]

  @@map("admins")
}

model OtpCode {
  id         String     @id @default(cuid())
  /// The inbox the code was sent to. Keyed on email rather than phone because
  /// the code now exists to prove control of the address you sign in with.
  email      String
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([email, purpose])
  @@map("otp_codes")
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String // "Home", "Office"
  line1     String
  line2     String?
  city      String   @default("Lagos")
  landmark  String? // "opposite the blue gate" — matters more than a street number here
  contact   String
  phone     String
  latitude  Float?
  longitude Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────────────────────────── vendors & catalog

model Vendor {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  tags            String[]
  /// Neighbourhood — "Lekki Phase 1". Shown to customers so they know where
  /// an item ships from; too granular to filter on.
  area            String?
  /// The state this vendor trades in. Coarse enough to be a useful filter and
  /// the unit Nigerians actually think in when judging whether something is
  /// close. Defaults to Lagos because every existing vendor is there.
  state           String   @default("Lagos")
  /// The vendor login. Nullable, unlike User and Rider, because a vendor is
  /// never self-registered — it exists because ops approved an application, and
  /// may be created by hand before anyone has an address on file. Postgres
  /// allows many NULLs under a unique index, so the constraint still holds for
  /// every vendor that does have one.
  email           String?  @unique
  /// Null until the vendor sets one. Ops creates the account with an address
  /// only; the vendor claims it through the password-reset flow, so no
  /// temporary password is ever transmitted or has to be changed later.
  passwordHash    String?
  /// Contact number, kept for orders and dispatch. No longer a login.
  phone           String?  @unique
  rating          Float    @default(5)
  ratingCount     Int      @default(0)
  etaMinMinutes   Int      @default(25)
  etaMaxMinutes   Int      @default(35)
  deliveryFeeKobo Int      @default(130000)
  freeOverKobo    Int?
  discountLabel   String?
  isVerified      Boolean  @default(false)
  isOpen          Boolean  @default(true)
  opensAt         String? // "08:00"
  closesAt        String? // "22:00"
  coverUrl        String?
  // Vendors may bid on open marketplace requests (design.md §11).
  canBid          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products     Product[]
  orders       Order[]
  bids         Bid[]
  favouritedBy Favourite[]
  invitedTo    MarketplaceRequest[] @relation("RequestInvites")
  /// Set when this vendor was created by approving an application.
  application  VendorApplication?

  @@map("vendors")
}

model Product {
  id            String   @id @default(cuid())
  vendorId      String
  name          String
  description   String?
  priceKobo     Int
  section       String? // "Popular", "Rice & Grains"
  badge         String? // "Bestseller"
  imageUrl      String?
  // true = also listed in the Marketplace tab, not just the vendor's menu
  isMarketplace Boolean  @default(false)
  isBiddable    Boolean  @default(false)
  inStock       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vendor     Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([vendorId])
  @@index([isMarketplace])
  @@map("products")
}

// ─────────────────────────────────────────────── orders

model Order {
  id         String       @id @default(cuid())
  reference  String       @unique // "SND-8841"
  type       OrderType
  // Defaulted so every existing row reads APP without a backfill, and so the
  // app's own create paths keep working untouched.
  channel    OrderChannel @default(APP)
  /// Set only by the website's booking endpoint. A client that times out
  /// waiting for a reply has no way of knowing whether the order was created,
  /// and the customer's natural response is to submit again — so the same key
  /// arriving twice returns the original order instead of creating a sibling.
  /// Nullable and unique: Postgres allows any number of NULLs in a unique
  /// index, so every existing and app-created order is unaffected.
  idempotencyKey String?   @unique
  status     OrderStatus  @default(PENDING_PAYMENT)
  customerId String
  vendorId   String?
  riderId    String?
  addressId  String?

  subtotalKobo    Int @default(0)
  deliveryFeeKobo Int @default(0)
  serviceFeeKobo  Int @default(0)
  discountKobo    Int @default(0)
  totalKobo       Int @default(0)
  // What the rider earns on this job, net of the platform commission.
  riderPayoutKobo Int @default(0)

  // Set when the customer schedules instead of ordering now.
  scheduledFor DateTime?
  // 4-digit code the customer reads out at the door (proof of delivery).
  deliveryCode String?
  proofUrl     String?
  cancelReason String?

  placedAt    DateTime?
  acceptedAt  DateTime?
  assignedAt  DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer      User                @relation(fields: [customerId], references: [id])
  vendor        Vendor?             @relation(fields: [vendorId], references: [id])
  rider         Rider?              @relation(fields: [riderId], references: [id])
  address       Address?            @relation(fields: [addressId], references: [id])
  items         OrderItem[]
  events        OrderEvent[]
  payments      Payment[]
  errandDetail  ErrandDetail?
  packageDetail PackageDetail?
  serviceDetail ServiceDetail?
  request         MarketplaceRequest?
  review          Review?
  supportRequests SupportRequest[]
  earning         RiderEarning?
  deliveryBids  DeliveryBid[]

  @@index([customerId, status])
  @@index([riderId, status])
  @@index([status, type])
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String?
  name          String // denormalised: the menu can change after the order
  note          String?
  unitPriceKobo Int
  quantity      Int      @default(1)
  createdAt     DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

/// Append-only audit trail. The customer's tracking stepper and the admin
/// timeline are both rendered from these rows — never from status alone.
/// A rider asking for more than the customer offered.
///
/// The customer names a delivery fee when they post. A rider who is happy with
/// it just accepts the job — that path needs no row here, and stays the fast
/// one, because most jobs should end there. This table exists only for the
/// minority case: a rider who wants the job but not at that price.
///
/// Deliberately separate from `Bid`, which is vendors quoting to supply goods on
/// a marketplace request. Same word, different parties, different lifecycle —
/// merging them would mean one table where half the columns are null.
model DeliveryBid {
  id        String            @id @default(cuid())
  orderId   String
  riderId   String
  /// What the rider wants instead. Always above the customer's offer: a rider
  /// happy with less would simply accept.
  priceKobo Int
  note      String?
  status    DeliveryBidStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  /// One live counter per rider per order — they revise it rather than stack.
  @@unique([orderId, riderId])
  /// The customer's list reads by order, cheapest first.
  @@index([orderId, priceKobo])
  @@map("delivery_bids")
}

enum DeliveryBidStatus {
  PENDING
  ACCEPTED
  /// Set on every other bid the moment one is accepted, so a rider whose offer
  /// lost is told rather than left watching a job that is already gone.
  DECLINED
  WITHDRAWN
}

/// What the customer is told, as opposed to what happened.
///
/// OrderEvent already records every transition, but it is an audit trail: it
/// has no per-person read state, its labels are written for operations rather
/// than for the person waiting at home, and it carries transitions nobody
/// should be pinged about. Notifications are the subset worth interrupting
/// someone for, in their language, with a record of whether they have seen it.
///
/// Deliberately written to the database rather than derived on read. When push
/// arrives, the sender needs a durable row to work from — "what have we already
/// told this person" cannot be recomputed from order state alone.
model Notification {
  id      String  @id @default(cuid())
  /// Exactly one of these is set. Customers and riders are different tables,
  /// and a rider needs telling about different things — that their offer won,
  /// that the customer has paid the seller, that the job they are driving to
  /// was cancelled — so the row carries whichever party it is for.
  userId  String?
  riderId String?
  /// Reserved for the day this carries more than order updates.
  type    String  @default("ORDER")
  title   String
  body    String
  /// Set when tapping it should open an order.
  orderId String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  rider Rider? @relation(fields: [riderId], references: [id], onDelete: Cascade)

  /// The unread badge and the list both read by recipient, newest first.
  @@index([userId, createdAt])
  @@index([riderId, createdAt])
  @@map("notifications")
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  label     String
  note      String?
  actorType String? // "customer" | "rider" | "admin" | "system"
  actorId   String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

model ErrandDetail {
  id                  String    @id @default(cuid())
  orderId             String    @unique
  task                String
  details             String?
  pickupName          String
  pickupAddress       String
  /// What the customer guessed before anyone had looked. Never charged — it
  /// exists so a rider can judge whether the job is worth accepting.
  budgetKobo          Int?
  /// What the rider found it actually costs, entered at the stall.
  actualItemKobo      Int?
  /// The merchant's account, entered by the rider and resolved against
  /// Paystack before the customer ever sees it. The resolved holder name is
  /// the whole safety property: a rider who types their own account number
  /// has to watch their own name appear on the customer's screen.
  merchantBankCode    String?
  merchantAccountNo   String?
  merchantAccountName String?
  merchantBankName    String?
  /// When the customer said they had transferred. Sendy cannot verify this —
  /// the money never passes through it — so this is a claim with a timestamp,
  /// which is still most of what a dispute needs.
  merchantPaidAt      DateTime?
  paymentProofUrl     String?
  /// The two rider pings.
  assetSecuredAt      DateTime?
  atDoorstepAt        DateTime?
  // What the rider actually spent, from the receipt. Change is refunded.
  spentKobo           Int?
  receiptUrl          String?
  photoUrls           String[]
  createdAt           DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("errand_details")
}

/// A person who comes to you and does a job.
///
/// Deliberately its own model rather than a flag on Vendor. A vendor sells
/// stock from a shopfront with a menu and a delivery fee; a provider sells an
/// hour of their time, has no inventory, and cannot quote until they know what
/// the job is. Forcing both through one table would mean half its columns are
/// meaningless on every row.
model ServiceProvider {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  /// "Barber", "Cleaning", "Plumbing" — the browse filter, and the one thing a
  /// customer picks before anything else.
  category    String
  /// What they do, in their own words, for the listing.
  bio         String?
  /// Skills shown as chips: ["Fades", "Beard trim"].
  tags        String[]
  area        String?
  state       String  @default("Lagos")
  phone       String? @unique
  email       String? @unique
  /// Null until they claim the account, exactly like Vendor — ops creates the
  /// provider first and the password-reset flow hands it over.
  passwordHash String?

  rating      Float   @default(5)
  ratingCount Int     @default(0)
  avatarUrl   String?

  /// What Sendy charges to get them to the door, by how they travel. Held per
  /// provider rather than globally because a provider two streets away and one
  /// across the lagoon do not cost the same to send.
  bikeFeeKobo Int     @default(100000)
  carFeeKobo  Int     @default(250000)
  /// Some jobs cannot go by bike at all — a cleaner with a vacuum, a plumber
  /// with pipe. Set false and the bike option is not offered.
  canTravelByBike Boolean @default(true)

  /// Roughly how long the job takes, so the customer knows what they are
  /// blocking out. Not a price input — the provider still quotes.
  typicalMinMinutes Int @default(30)
  typicalMaxMinutes Int @default(60)

  isVerified  Boolean  @default(false)
  /// Accepting work right now. The provider's own toggle.
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      ServiceDetail[]
  application ProviderApplication?

  @@index([category])
  @@index([state, category])
  @@map("service_providers")
}

/// The service half of an order, mirroring ErrandDetail.
model ServiceDetail {
  id         String @id @default(cuid())
  orderId    String @unique
  providerId String

  /// What the customer wants done, in their words.
  task    String
  details String?
  /// Where the provider is going.
  address String
  landmark String?

  /// How they travel, and what Sendy charged for it. The fee is copied here at
  /// booking rather than read back from the provider, so a later price change
  /// cannot rewrite what someone was already charged.
  arrivalMode    ArrivalMode
  arrivalFeeKobo Int

  /// When the customer wants them. Null means as soon as possible.
  scheduledFor DateTime?

  /// What the customer expects to pay, before anyone has seen the job. Never
  /// charged — it is there so a provider can judge whether to accept.
  budgetKobo Int?
  /// What the provider says the job costs, once they know what it is. Paid to
  /// the provider directly; Sendy never touches it.
  quotedKobo Int?
  /// The customer's claim that they have paid the provider. Sendy cannot
  /// verify it — the money never passes through — so this is a timestamp and
  /// an optional receipt, which is most of what a dispute needs.
  paidProviderAt  DateTime?
  paymentProofUrl String?

  /// The provider's two pings: on the way, and done.
  enRouteAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider ServiceProvider @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@map("service_details")
}

model PackageDetail {
  id             String     @id @default(cuid())
  orderId        String     @unique
  pickupName     String
  pickupAddress  String
  pickupPhone    String?
  dropoffName    String
  dropoffAddress String
  dropoffPhone   String
  size           ParcelSize @default(SMALL)
  contents       String? // "Documents", "Food", "Electronics"
  isFragile      Boolean    @default(false)
  notes          String?
  createdAt      DateTime   @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("package_details")
}

// ─────────────────────────────────────────────── marketplace (design.md §11)

model MarketplaceRequest {
  id          String        @id @default(cuid())
  customerId  String
  title       String
  details     String?
  quantity    Int           @default(1)
  budgetKobo  Int?
  dropoffArea String
  addressId   String?
  photoUrls   String[]
  status      RequestStatus @default(OPEN)
  closesAt    DateTime
  // Set once the customer picks a winner; the order is created at that point.
  orderId     String?       @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  customer User   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order? @relation(fields: [orderId], references: [id])
  bids     Bid[]

  /// Vendors ops explicitly asked to quote. Empty means every eligible vendor
  /// sees it; once set, the open-requests feed is limited to these.
  invitedVendors Vendor[] @relation("RequestInvites")

  @@index([status, closesAt])
  @@index([customerId])
  @@map("marketplace_requests")
}

model Bid {
  id         String    @id @default(cuid())
  requestId  String
  vendorId   String
  priceKobo  Int
  etaMinutes Int
  note       String?
  status     BidStatus @default(SUBMITTED)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  request MarketplaceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vendor  Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // One live bid per vendor per request; they update it rather than stacking.
  @@unique([requestId, vendorId])
  @@index([requestId, priceKobo])
  @@map("bids")
}

// ─────────────────────────────────────────────── money

model Payment {
  id               String          @id @default(cuid())
  orderId          String
  provider         PaymentProvider
  reference        String          @unique // Paystack reference, or an internal one for wallet
  amountKobo       Int
  status           PaymentStatus   @default(PENDING)
  authorizationUrl String?
  // Raw provider payload, kept for reconciliation and dispute evidence.
  providerPayload  Json?
  paidAt           DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  /// Who in ops confirmed the money arrived. Null for anything a gateway
  /// created, which is how a gateway payment is told apart from a hand-entered
  /// one. Cash and transfers have no external record to check against, so the
  /// only control on "this was received" is knowing whose word it is.
  recordedByAdminId String?
  /// Free text from whoever recorded it — a transfer reference, who handed the
  /// cash over, why the amount differs from the order total.
  note              String?

  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: a staff member leaving must not delete the record of
  /// money the company took.
  recordedBy  Admin? @relation(fields: [recordedByAdminId], references: [id], onDelete: SetNull)

  @@index([orderId])
  // The payments ledger reads newest-first, optionally filtered by status.
  @@index([status, createdAt])
  @@map("payments")
}

model WalletTransaction {
  id          String        @id @default(cuid())
  userId      String
  type        WalletTxnType
  amountKobo  Int // positive = credit, negative = debit
  balanceKobo Int // running balance after this txn, for statements
  description String
  reference   String?
  createdAt   DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

model RiderEarning {
  id             String    @id @default(cuid())
  riderId        String
  orderId        String    @unique
  grossKobo      Int
  commissionKobo Int
  netKobo        Int
  isPaidOut      Boolean   @default(false)
  paidOutAt      DateTime?
  createdAt      DateTime  @default(now())

  /// Which payout carried this earning. Set when the payout is created and
  /// cleared if the transfer fails, so the earning returns to the payable pool
  /// rather than vanishing into a payout that never happened.
  payoutId String?

  /// Set when the order behind this earning was refunded. A voided earning is
  /// never payable. Without this, refunding an order left the rider still owed
  /// for a sale that no longer exists — harmless while no money moved, and a
  /// silent double-spend the moment transfers go live.
  voidedAt   DateTime?
  voidReason String?

  rider  Rider   @relation(fields: [riderId], references: [id], onDelete: Cascade)
  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payout Payout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([riderId, createdAt])
  @@index([riderId, isPaidOut])
  @@index([payoutId])
  @@map("rider_earnings")
}

/// Where a payout sits with the bank.
///
/// PENDING exists for the gap between "we decided to pay this" and "Paystack
/// has accepted it". A row is written in that state *before* the provider is
/// called, so a transfer that succeeds while the response is lost still has a
/// reference to reconcile against instead of being sent a second time.
enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

/// One bank transfer to one rider, covering a set of earnings.
model Payout {
  id         String       @id @default(cuid())
  riderId    String
  amountKobo Int
  status     PayoutStatus @default(PENDING)

  /// Our idempotency key, sent to Paystack as the transfer reference. Unique so
  /// the database refuses a duplicate even if the application logic slips.
  reference String @unique

  /// Paystack's handles, kept for reconciliation and support.
  transferCode  String?
  recipientCode String?

  /// Snapshot of where the money was sent. The rider can change their bank
  /// details later; what a past payout says must not change with them.
  bankName      String?
  bankAccountNo String?

  failureReason   String?
  providerPayload Json?
  createdAt       DateTime  @default(now())
  settledAt       DateTime?

  rider    Rider          @relation(fields: [riderId], references: [id], onDelete: Cascade)
  earnings RiderEarning[]

  @@index([riderId, createdAt])
  @@index([status])
  @@map("payouts")
}

/// Where a would-be vendor sits in review. Mirrors RiderStatus, minus
/// SUSPENDED: suspending a live vendor is done on the Vendor row itself.
enum VendorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * Someone asking to sell on Sendy Errands, from Profile → Become a vendor.
 * Deliberately not a Vendor row with a pending flag. An unapproved applicant
 * has none of what a Vendor needs — no slug, no delivery fee, no catalogue —
 * and every public vendor query would have to remember to exclude them. Kept
 * separate, approval is the moment a Vendor is created, and the queries that
 * serve customers cannot accidentally surface an application.
 */
/**
 * Someone asking to become a service provider.
 *
 * Mirrors VendorApplication deliberately: a provider is onboarded the same way
 * a vendor is — they apply, ops reviews, and approval is what creates the
 * ServiceProvider row. Nobody self-registers into either.
 *
 * It reuses VendorApplicationStatus rather than declaring a second identical
 * enum. The three states are the same three states; renaming that type to
 * something neutral would be a migration touching live columns for a naming
 * improvement, which is not a trade worth making.
 */
model ProviderApplication {
  id       String @id @default(cuid())
  /// The name they trade under — "Kay Cuts", not necessarily a person's name.
  name     String
  /// Barber, Cleaning, Plumbing. Free text, like ServiceProvider.category.
  category String
  area     String
  state    String @default("Lagos")
  phone    String
  email    String?
  /// What they do, in their own words — becomes the listing bio on approval.
  bio      String?
  /// Skills, shown as chips on the listing.
  tags     String[]
  /// False where the kit will not fit on a bike. Asked at application time
  /// because it decides which arrival options a customer is ever offered.
  canTravelByBike Boolean @default(true)
  /// Why it was rejected, or an internal remark.
  note     String?
  status   VendorApplicationStatus @default(PENDING)

  /// The signed-in customer who applied, so they can be told the outcome.
  applicantId String?
  applicant   User?   @relation(fields: [applicantId], references: [id], onDelete: SetNull)

  /// Set once approved — the ServiceProvider this application became.
  providerId String?          @unique
  provider   ServiceProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, createdAt])
  @@map("provider_applications")
}

model VendorApplication {
  id           String                  @id @default(cuid())
  businessName String
  category     String
  area         String
  state        String                  @default("Lagos")
  phone        String
  address      String?
  contactName  String?
  note         String? // why it was rejected, or an internal remark
  status       VendorApplicationStatus @default(PENDING)

  /// The signed-in customer who applied, so they can be told the outcome.
  applicantId String?
  applicant   User?   @relation(fields: [applicantId], references: [id], onDelete: SetNull)

  /// Set once approved — the Vendor this application became.
  vendorId String? @unique
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, createdAt])
  @@map("vendor_applications")
}

/**
 * A vendor a customer saved.
 * Server-side rather than on the device: the heart was local component state,
 * so it reset on every remount and meant nothing on a second device or after a
 * reinstall. A saved vendor is a signal worth keeping — it is also the only
 * content behind Profile → Favourites.
 */
model Favourite {
  id        String   @id @default(cuid())
  userId    String
  vendorId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// One row per pair — saving twice is idempotent, not a duplicate.
  @@unique([userId, vendorId])
  @@index([userId])
  @@map("favourites")
}

/// ---------------------------------------------------------------------------
/// Service catalogue and pricing.
///
/// Migrated out of the PHP site's MySQL, where it was the last thing binding
/// the public booking form to that database — book.php read this catalogue on
/// every page load to render the service picker and its prices.
/// ---------------------------------------------------------------------------
model Service {
  id String @id @default(cuid())

  /// Stable identifier used in URLs and by the website's booking form
  /// ("market-shopping"). Renaming a service must not change this.
  slug             String  @unique
  name             String
  shortDescription String?
  description      String?
  /// An icon *name*, resolved by whichever front-end renders it, rather than a
  /// path — so the app and the website can each draw it in their own set.
  icon             String?
  /// Kobo, like every other money column here. MySQL stored this as DECIMAL
  /// naira; carrying that over would have put two money formats in one schema.
  baseFeeKobo      Int     @default(0)
  isActive         Boolean @default(true)
  /// Position in the picker. Services get reordered, so this is not the id.
  sortOrder        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricingRules PricingRule[]

  @@index([isActive, sortOrder])
  @@map("services")
}

enum PricingRuleType {
  PER_KM
  PER_KG
  WAITING_TIME
  URGENCY_MULTIPLIER
  FLAT_FEE
}

/// Carried over from the PHP support form, because a customer picking
/// "Refund request" tells ops more than a subject line does.
enum SupportCategory {
  ORDER_ISSUE
  MISSING_ITEM
  DELIVERY_PROBLEM
  REFUND_REQUEST
  PAYMENT_ISSUE
  GENERAL
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

/// A support request from the website — deliberately not a ticket thread.
///
/// The PHP site had threaded tickets with replies, and used them twice. Support
/// actually happens on WhatsApp and in the Zoho inbox that holds the root MX
/// for the domain. So this records what came in and lets ops track whether it
/// has been dealt with, rather than rebuilding a messaging product nobody used.
/// There is no reply here on purpose: answering happens where the customer
/// already is.
model SupportRequest {
  id        String @id @default(cuid())
  reference String @unique

  /// Both optional: someone can ask for help without an account, and not every
  /// question is about a specific errand.
  userId  String?
  orderId String?

  name     String
  email    String?
  phone    String?
  subject  String
  category SupportCategory @default(GENERAL)
  message  String

  status SupportStatus @default(OPEN)
  /// Set the first time ops opens it, so "nobody has looked at this yet" is
  /// visible at a glance rather than inferred from the status.
  readAt DateTime?
  /// Where ops records what was done, since the conversation itself lives in
  /// WhatsApp or the mailbox.
  internalNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("support_requests")
}

/// Reviews are moderated, not published on arrival: they appear on the public
/// site, so a complaint written in anger or an abusive comment should not be
/// live before anyone has read it. PENDING is the default for that reason.
enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

model Review {
  id String @id @default(cuid())

  /// One review per order — the unique constraint is the rule, not a hint.
  orderId    String  @unique
  customerId String
  /// Nullable, and set null rather than cascading if the rider leaves: the
  /// customer's review of the service outlives any one rider's account.
  riderId    String?

  /// 1–5. Overall is required; the other two are optional because the old form
  /// let people rate the service without judging the rider individually.
  overallRating Int
  riderRating   Int?
  serviceRating Int?

  comment String?
  status  ReviewStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer User   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rider    Rider? @relation(fields: [riderId], references: [id], onDelete: SetNull)

  /// The moderation queue is read newest-first, filtered by status.
  @@index([status, createdAt])
  @@index([riderId])
  @@map("reviews")
}

model PricingRule {
  id        String          @id @default(cuid())
  serviceId String
  type      PricingRuleType
  label     String
  /// Decimal rather than kobo, deliberately: what this number means depends on
  /// `type`. It is a naira rate for PER_KM and FLAT_FEE, but a bare multiplier
  /// (1.5) for URGENCY_MULTIPLIER. One integer kobo column cannot hold both
  /// without lying about one of them.
  value     Decimal         @db.Decimal(10, 2)
  isActive  Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("pricing_rules")
}
